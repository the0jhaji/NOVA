# NOVA Voice Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# Speech Recognition Provider: "google" | "whisper"
STT_PROVIDER=google

# Text-to-Speech Provider: "edge-tts" | "pyttsx3"
TTS_PROVIDER=edge-tts

# Edge TTS Voice (for edge-tts provider)
# Female voices: en-US-AvaNeural, en-US-JennyNeural, hi-IN-SwaraNeural
TTS_VOICE=en-US-AvaNeural

# Whisper model size (if using whisper STT): tiny | base | small | medium | large
WHISPER_MODEL=base

# Language for speech recognition: en-US | hi-IN | auto
RECOGNITION_LANGUAGE=auto

# Wake word activation (true = requires wake word, false = always listening)
WAKE_WORD_ENABLED=false

# Wake word text
WAKE_WORD=nova

# ---------------------------------------------------------------------------
# Automation layer (Phase 2 - Windows tools)
# ---------------------------------------------------------------------------

# If true, CONFIRMATION_REQUIRED actions (delete file, install software)
# execute WITHOUT a spoken confirmation. Default false = ask first.
AUTOMATION_AUTO_CONFIRM=false

# If true, HIGH_RISK actions may run after explicit confirmation.
# No high-risk tools ship yet; keep false.
AUTOMATION_ALLOW_HIGH_RISK=false

# Where screenshots are saved (empty = Pictures\NOVA Screenshots)
SCREENSHOT_DIR=

# JSON file with custom app launch commands (see apps_config.json)
APPS_CONFIG_FILE=apps_config.json

# Default folder for "search files" (empty = user home)
SEARCH_ROOT=

# ---------------------------------------------------------------------------
# Local-first AI brain (Phase 4)
# ---------------------------------------------------------------------------

# AI provider: "ollama" (local, default) | "cloud" | "none"
AI_PROVIDER=ollama

# Ollama model tag (qwen3:8b is the recommended local default)
LOCAL_MODEL=qwen3:8b

# Local model runtime endpoint (loopback only)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_TIMEOUT=90

# Keep true unless you deliberately run a model runtime on another machine
LOCAL_AI_ALLOW_REMOTE=false

# Cloud AI. MUST stay false unless explicitly enabled in Privacy settings.
# Enabling requires an explicit user confirmation and never happens silently.
CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=openai-compatible
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL=
CLOUD_AI_KEY=

# Privacy boundary
PRIVACY_NETWORK_MODE=local-only
PRIVACY_TELEMETRY_ENABLED=false
PRIVACY_SCREEN_AWARENESS=false
PRIVACY_CONVERSATION_RETENTION=session
PRIVACY_AUTO_DELETE_TEMP=true

# ---------------------------------------------------------------------------
# Companion memory (Phase 5)
# ---------------------------------------------------------------------------

# Master switch for NOVA remembering preferences locally
MEMORY_ENABLED=true
# "persistent" (SQLite on disk) | "session" (in-memory only)
MEMORY_SCOPE=persistent
MEMORY_DB_PATH=

# ---------------------------------------------------------------------------
# Browser automation (Phase 5, Chrome DevTools Protocol)
# ---------------------------------------------------------------------------

BROWSER_AUTOMATION_ENABLED=true
# "edge" (default) | "chrome" | "auto" (first found)
BROWSER_CHANNEL=edge
# Headless mode (true = no visible window; used by tests)
BROWSER_HEADLESS=false
# Local CDP debug port (never exposed publicly)
BROWSER_CDP_PORT=9223
BROWSER_USER_DATA_DIR=

# OpenAI API key (for future brain integration)
OPENAI_API_KEY=

# Debug mode
DEBUG=false
